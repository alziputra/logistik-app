# ==============================================================================
# Konfigurasi Firebase Firestore (Wajib Diisi untuk Pengguna Baru)
# ==============================================================================
# Langkah Penggunaan:
# 1. Salin file ini menjadi .env:
#    cp .env.example .env
# 2. Buat project Firebase Firestore di https://console.firebase.google.com/
# 3. Masukkan kredensial Web App Firebase Anda di bawah ini
# 4. Inisialisasi database Firestore dengan data master awal:
#    npm run seed
# 5. Jalankan aplikasi web:
#    npm run dev
# ==============================================================================

VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
